import "../defaults.pkl" as defaults

profile = defaults.value

output {
  value = new Mapping {
    ["settings"] = new Mapping {
      ["model"] = profile.models[profile.roles["primary"].preset].nativeModel
      ["permissions"] = new Mapping { ["defaultMode"] = "ask" }
      ["instructions"] = "\(profile.policy.primaryInstructions) \(profile.policy.efficiencyInstructions) \(profile.roles["primary"].instructions) \(profile.environment.instructions)"
    }
    ["agents"] = new Mapping {
      for (name, role in profile.roles) {
        [name] = new Mapping {
          ["model"] = profile.models[role.preset].nativeModel
          ["readOnly"] = role.readOnly
          ["instructions"] = "\(profile.policy.primaryInstructions) \(profile.policy.efficiencyInstructions) \(role.instructions) \(profile.environment.instructions)"
        }
      }
    }
  }
  renderer = new JsonRenderer {}
}
