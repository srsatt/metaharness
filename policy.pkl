import "schema.pkl" as schema
import "benjamin-plus.pkl" as benjaminPlus

value = new schema.Policy {
  primaryInstructions = "For a substantial task with an architecture plan or draft, architectural choice, migration, RFC, or difficult decomposition, immediately invoke architect before implementation when available. Invoke solution-architect only when the user explicitly requests it or the work is project-scale: a project specification, greenfield exploration, or exceptional multi-system design. Do not invoke solution-architect for routine architecture work. If an invoked architecture role is unavailable, primary produces the required architecture packet before implementation. Do not invoke architect for routine bounded work."
  efficiencyInstructions = benjaminPlus.instructions
  safetyInstructions = "Preserve unrelated changes. Inspect before editing. Use focused checks. Never weaken permissions or silently substitute a model."
  routing = new Mapping {
    ["failed_authoritative_check"] = "implementer"
    ["difficult_code_debugging"] = "implementer"
    ["architecture"] = "architect"
    ["migration"] = "architect"
    ["rfc"] = "architect"
    ["difficult_decomposition"] = "architect"
    ["substantial_architecture_plan_or_draft"] = "architect"
    ["explicit_solution_architect_request"] = "solution-architect"
    ["project_specification"] = "solution-architect"
    ["greenfield_exploration"] = "solution-architect"
    ["exceptional_multi_system_design"] = "solution-architect"
    ["acceptance_check"] = "verifier"
    ["substantial_or_risky_review"] = "reviewer"
    ["focused_research"] = "researcher"
  }
}
